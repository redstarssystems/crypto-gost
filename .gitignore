# standard (default) exclusions
target/
/classes
/checkouts
*.jar
!gradle/wrapper/gradle-wrapper.jar
**/build/
local.properties
*.class
*.xml.asc
/.cpcache
/.lein-*
/.nrepl-history
/.nrepl-port
.hgignore
.hg/
.cpcache
resources/version.txt

# exclude all .idea except some subfolders
.idea/*
!.idea/clojure-deps.xml
!.idea/codeStyles/
!.idea/copyright/
*.iml

# exclude whole folders with logs
log
logs

# exclude files of Calva, Eclipse, Leiningen, clojure-lsp, nrepl and other tools
.calva/output-window/
.classpath
.clj-kondo/.cache
.eastwood
.factorypath
.java-version
.lein-*
.claude/*
.lsp/.cache
.agents/*
/AGENTS.md
.lsp/sqlite.db
.nrepl-history
.nrepl-port
.project
.rebel_readline_history
.settings
.socket-repl-port
.sw*
.vscode
*.swp
*~
README.xml
/CHANGELOG.xml
.DS_Store
.idea
.gradle/
.flattened-pom.xml
/crypto-gost-tls13/doc/architecture.xml
/crypto-gost-tls13/doc/manual-interop-test.xml
.cifuzz-corpus/
**/crash-*
test-certs


# дампы кучи и аварийные журналы JVM (могут оказаться в рабочем каталоге при падении тестов и замеров)
*.hprof
hs_err_pid*.log

# файл, который maven-shade-plugin создаёт при сборке examples/jsse
examples/jsse/dependency-reduced-pom.xml

# Метка тестового корня КриптоПро (рабочий файл прогона crossval-cades)
x-validation-tests/.crossval-root-mark.*
